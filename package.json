{
  "name": "vitepress-multilanguage-setup",
  "version": "1.0.0",
  "description": "Template repository for setting up a VitePress documentation site with multi-language support.",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "code-format": "prettier --write .",
    "md-lint": "markdownlint-cli2 --config .markdownlint.json \"**/*.md\" \"#node_modules\" --fix",
    "lint": "pnpm run code-format && pnpm run md-lint",
    "tree": "tree docs -P \"*.md\" > structure.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "@davidingplus/vitepress-image-viewer": "^1.1.5",
    "init": "^0.1.2",
    "js-yaml": "^4.1.1",
    "markdownlint-cli2": "^0.20.0",
    "pnpm": "^10.25.0",
    "prettier": "^3.7.4",
    "vitepress": "2.0.0-alpha.15",
    "vitepress-mermaid-renderer": "^1.1.6",
    "vitepress-sidebar": "^1.33.1",
    "vue": "^3.5.25",
    "wrangler": "^4.53.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
